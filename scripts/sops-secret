#!/bin/sh
set -eu

if [ "$#" -ne 1 ]; then
  echo 'usage: scripts/sops-secret KEY' >&2
  exit 64
fi

case "$1" in
  CLOUDFLARE_API_TOKEN|OPERATOR_BEARER_SECRET) ;;
  *)
    echo "unsupported SOPS key: $1" >&2
    exit 64
    ;;
esac

command -v sops >/dev/null || { echo 'sops is required' >&2; exit 69; }

if ! command -v age-plugin-sshagent >/dev/null && command -v go >/dev/null; then
  go_path=$(go env GOPATH)
  if [ -x "$go_path/bin/age-plugin-sshagent" ]; then
    PATH="$go_path/bin:$PATH"
    export PATH
  fi
fi

command -v age-plugin-sshagent >/dev/null || { echo 'age-plugin-sshagent is required' >&2; exit 69; }

exec sops decrypt --extract "[\"$1\"]" secrets/ops.env
