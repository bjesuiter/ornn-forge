#!/bin/sh
set -eu

if [ "$#" -ne 1 ]; then
  echo 'usage: scripts/sops-secret KEY' >&2
  exit 64
fi

case "$1" in
  CLOUDFLARE_API_TOKEN|OPERATOR_BEARER_SECRET) secret_file=secrets/ops.env ;;
  BETTER_AUTH_SECRET|GITHUB_CLIENT_SECRET) secret_file=secrets/development.env ;;
  ORNN_RUNNER_CREDENTIAL) secret_file=secrets/runner-debug.env ;;
  ORNN_SMOKE_BASE_URL|ORNN_SMOKE_WEBHOOK_SECRET|ORNN_SMOKE_INSTALLATION_ID|ORNN_SMOKE_REPOSITORY_ID|ORNN_SMOKE_REPOSITORY_FULL_NAME) secret_file=secrets/smoke.env ;;
  *)
    echo "unsupported SOPS key: $1" >&2
    exit 64
    ;;
esac

exec ./scripts/sops decrypt --extract "[\"$1\"]" "$secret_file"
