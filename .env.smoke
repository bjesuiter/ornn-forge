# Explicit production smoke checks. All values resolve from the SOPS-encrypted
# secrets/smoke.env file; this profile is never loaded by normal development
# or deployment commands.
ORNN_SMOKE_BASE_URL=exec("./scripts/sops-secret ORNN_SMOKE_BASE_URL")
ORNN_SMOKE_WEBHOOK_SECRET=exec("./scripts/sops-secret ORNN_SMOKE_WEBHOOK_SECRET")
# The deployed smoke uses the existing operator credential; do not duplicate
# that reusable secret in the smoke file.
ORNN_SMOKE_OPERATOR_BEARER_SECRET=exec("./scripts/sops-secret OPERATOR_BEARER_SECRET")
ORNN_SMOKE_INSTALLATION_ID=exec("./scripts/sops-secret ORNN_SMOKE_INSTALLATION_ID")
ORNN_SMOKE_REPOSITORY_ID=exec("./scripts/sops-secret ORNN_SMOKE_REPOSITORY_ID")
ORNN_SMOKE_REPOSITORY_FULL_NAME=exec("./scripts/sops-secret ORNN_SMOKE_REPOSITORY_FULL_NAME")
