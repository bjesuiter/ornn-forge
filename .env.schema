# @currentEnv=$DEV_ENV
# ---

# @type=enum(development, ops, smoke, runner-setup, runner-debug)
DEV_ENV=development

# Public local Better Auth origin. The Cloudflare Vite plugin receives it from
# Varlock through CLOUDFLARE_INCLUDE_PROCESS_ENV.
# @public @required=forEnv(development) @type=url
BETTER_AUTH_URL=

# GitHub App OAuth client ID. This identifies the app but is not a credential.
# @public @required=forEnv(development)
GITHUB_CLIENT_ID=

# Local-only session signing secret and the dedicated development client secret.
# They are stored in the SOPS-encrypted development secrets file.
# @sensitive @required=forEnv(development)
BETTER_AUTH_SECRET=

# @sensitive @required=forEnv(development)
GITHUB_CLIENT_SECRET=

# The smoke profile is used only by explicit production admission and Runner
# setup checks. Its values are stored together in secrets/smoke.env.
# @public @required=forEnv(smoke) @type=url
ORNN_SMOKE_BASE_URL=

# @sensitive @required=forEnv(smoke)
ORNN_SMOKE_WEBHOOK_SECRET=

# @sensitive @required=forEnv(smoke)
ORNN_SMOKE_OPERATOR_BEARER_SECRET=

# @public @required=forEnv(smoke)
ORNN_SMOKE_INSTALLATION_ID=

# @public @required=forEnv(smoke)
ORNN_SMOKE_REPOSITORY_ID=

# @public @required=forEnv(smoke)
ORNN_SMOKE_REPOSITORY_FULL_NAME=

# Runner setup needs only this URL and obtains the Runner ID and credential
# interactively. The debug profile then resolves the credential from Keychain
# and mounts it into Docker as an in-memory secret.
# @public @required=forEnv(runner-setup, runner-debug) @type=url
ORNN_CONTROL_PLANE_URL=

# Populated by `bun run runner:setup`; the debug launcher verifies it before
# starting Docker Compose.
# @public @required=forEnv(runner-debug)
ORNN_RUNNER_ID=

# Stored by `bun run runner:setup` in the SOPS-encrypted Runner debug secrets
# file and exposed to Docker only as the existing Docker Secret.
# @sensitive @required=forEnv(runner-debug)
ORNN_RUNNER_CREDENTIAL=
