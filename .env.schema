# @plugin(@varlock/bitwarden-plugin)
# @initBwp(sessionTtl="1h", cacheTtl="5m")
# @currentEnv=$DEV_ENV
# ---

# @type=enum(development, ops, runner-debug)
DEV_ENV=development

# Public local Better Auth origin. The Cloudflare Vite plugin receives it from
# Varlock through CLOUDFLARE_INCLUDE_PROCESS_ENV.
# @public @required=forEnv(development) @type=url
BETTER_AUTH_URL=

# GitHub App OAuth client ID. This identifies the app but is not a credential.
# @public @required=forEnv(development)
GITHUB_CLIENT_ID=

# Local-only session signing secret and the dedicated development client secret.
# They are stored in macOS Keychain via `varlock keychain set`.
# @sensitive @required=forEnv(development)
BETTER_AUTH_SECRET=

# @sensitive @required=forEnv(development)
GITHUB_CLIENT_SECRET=

# The local debug container connects to the selected Control Plane with this
# dedicated Runner credential. Varlock resolves it from macOS Keychain and
# Docker Compose mounts it as an in-memory secret, never as a host file.
# @public @required=forEnv(runner-debug) @type=url
ORNN_CONTROL_PLANE_URL=

# @public @required=forEnv(runner-debug)
ORNN_RUNNER_ID=

# @sensitive @required=forEnv(runner-debug)
ORNN_RUNNER_CREDENTIAL=
