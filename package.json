{
  "name": "ornn-forge",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "DEV_ENV=development CLOUDFLARE_INCLUDE_PROCESS_ENV=true bunx varlock run -- vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "env:ops": "DEV_ENV=ops varlock load",
    "deploy": "bun run build && DEV_ENV=ops varlock run -- wrangler deploy",
    "cf-typegen": "wrangler types",
    "test": "bun test",
    "runner:fixture": "bun run --filter @ornn-forge/runner fixture",
    "test:smoke:d1": "bun run scripts/smoke-deployed-d1.ts"
  },
  "dependencies": {
    "@ornn-forge/domain": "workspace:*",
    "@ornn-forge/protocol": "workspace:*",
    "@tanstack/react-router": "1.170.17",
    "@tanstack/react-start": "1.168.27",
    "better-auth": "1.7.3",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.44.0",
    "bun-types": "1.4.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@varlock/bitwarden-plugin": "^2.0.0",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "7.0.2",
    "varlock": "^1.10.0",
    "vite": "8.1.4",
    "wrangler": "4.110.0"
  }
}
