{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ornn-forge",
  "compatibility_date": "2026-07-10",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "d1_databases": [
    {
      "binding": "ORNN_D1",
      "database_name": "ornn-forge",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
